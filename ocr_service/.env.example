# Redis
REDIS_URL=redis://localhost:6379/0
OCR_INPUT_STREAM=ocr:processor:stream
LLM_OUTPUT_STREAM=llm:processor:stream
OCR_CONSUMER_GROUP=ocr-external-workers

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cortex-videos
MINIO_SECURE=false

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=cortex

# Processing
TRANSCRIPT_WAIT_TIMEOUT_SECONDS=300
OCR_TEMP_DIR=/tmp/ocr_processing

# Logging
OCR_LOG_LEVEL=INFO
