# ── Mezon ────────────────────────────────────────────────────────────────
# Lấy từ Mezon developer portal (đăng nhập Mezon → developer portal →
# tạo bot → mời bot vào clan).
#
# MEZON_BOT_ID là BẮT BUỘC, không phải tuỳ chọn: SDK ném "botId is
# required" ngay trong constructor. Ví dụ `new MezonClient({ token })`
# trong docs Mezon sẽ không chạy.
MEZON_BOT_ID=
MEZON_BOT_TOKEN=

# ── Cortex backend ───────────────────────────────────────────────────────
CORTEX_API_URL=http://localhost:8000

# ⚠️ Khoá này cho phép hành động với tư cách BẤT KỲ user nào.
# Phải khớp INTERNAL_API_KEY trong backend/.env.
# Bot chỉ được chạy trong mạng nội bộ; không bao giờ để lộ ra client,
# không log ra, không gửi vào chat.
CORTEX_INTERNAL_API_KEY=

CORTEX_TIMEOUT_MS=30000

# ── Bot HTTP server (backend gọi vào để gửi thông báo — M2) ───────────────
# Phải khớp MEZON_BOT_INTERNAL_URL bên backend.
BOT_HOST=127.0.0.1
BOT_PORT=8100

# ── Tuỳ chọn ─────────────────────────────────────────────────────────────
BOT_COMMAND_PREFIX=*
LOG_LEVEL=info

# Giữ lại message "🧠 Đã suy nghĩ" (reasoning + các bước tool) sau khi
# lượt chat kết thúc. Transcript là một message riêng nằm TRÊN câu trả
# lời, giống layout của web. Bật sẵn vì trên Mezon đây là cách duy nhất
# thấy agent đã nghĩ gì và chạy tool nào — web còn có pane hội thoại và
# devtools, DM thì không.
# Đặt false để trở về đúng hành vi web: message transcript bị XOÁ khi
# lượt chat xong, chỉ còn câu trả lời.
BOT_KEEP_THINKING=true

# ── Object storage (chỉ dùng cho `*test svg`) ──────────────────────────────
# `*test svg` upload ảnh PNG bảng lên MinIO (đã chạy sẵn trong
# infrastructure/docker-compose.yml) rồi gửi link thật, vì gửi thẳng bytes
# qua data: URI làm rớt kết nối (message quá khổ với Mezon gateway).
# MINIO_ENDPOINT: nơi CHÍNH bot này kết nối tới để upload (cùng máy → dùng
# localhost được). MINIO_PUBLIC_URL: URL public trỏ tới CÙNG cổng đó (vd.
# VS Code Dev Tunnel) — đây là link Mezon's servers thực sự fetch, nên
# không thể là localhost. Không đặt các biến này thì `*test svg` vẫn chạy
# bình thường, chỉ báo lỗi rõ ràng thay vì crash.
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cortex-recordings
MINIO_PUBLIC_URL=
